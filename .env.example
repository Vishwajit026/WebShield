# ============================================================
# WebShield Environment Variables — EXAMPLE FILE
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----
# Values: development | production | test
NODE_ENV=development
PORT=5000
# Values: debug | info | warn | error (default: info in production)
LOG_LEVEL=debug

# ---- Database ----
# PostgreSQL connection string (required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example: postgresql://postgres:password@localhost:5432/webshield
# Production: Use a strong, unique password. Enable SSL with ?sslmode=require
DATABASE_URL=

# ---- Authentication ----
# CRITICAL: Both secrets MUST be unique, random, and at least 64 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# WARNING: Rotating these secrets will invalidate ALL existing sessions.
JWT_SECRET=
REFRESH_TOKEN_SECRET=

# Access token lifetime (default: 15m)
# Shorter is more secure. Recommended: 15m for production.
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token lifetime (default: 7d)
# Must be in days format: 7d, 30d
REFRESH_TOKEN_EXPIRES_IN=7d

# ---- CORS ----
# Comma-separated list of allowed origins
# Production: Set to your exact frontend domain (e.g. https://webshield.example.com)
# NEVER use * in production.
CORS_ORIGIN=http://localhost:5173

# ---- Development Seed ----
# Used by: pnpm --filter @webshield/api db:seed
# Must be at least 12 characters. If not set, seed is skipped.
# NEVER set this in production. Remove or leave empty.
DEV_ADMIN_PASSWORD=

# ---- Scanner ----
# Request timeout for scanning external targets (ms)
SCAN_TIMEOUT=10000
# Maximum concurrent HTTP requests per scan
MAX_SCAN_REQUESTS=10
